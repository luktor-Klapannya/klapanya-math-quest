# Public browser configuration. Copy to .env.staging.local for a staging build.
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_OR_ANON_KEY
# Optional dedicated API HTTPS origin; blank uses the same-origin /game-api reverse proxy.
VITE_GAME_API_BASE_URL=
# Never put service-role keys or private AI API keys in VITE_* variables.
